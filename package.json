{
	"name": "periodicity",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"description": "An interactive atlas of the chemical elements",
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun --bun vite --host 0.0.0.0",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host 0.0.0.0",
		"start": "bun run preview",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "latest",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/space-grotesk": "^5.2.10"
	}
}
